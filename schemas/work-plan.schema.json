{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldktech.dev/schemas/linear-role-work-plan.schema.json",
  "title": "Linear Role Work Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "mode", "projectId", "teamId", "summary", "resources", "issues"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "linear-role-work-plan" },
    "mode": { "enum": ["preview", "apply"] },
    "projectId": { "type": "string", "minLength": 1 },
    "teamId": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "type"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "title": { "type": "string", "minLength": 1 },
          "type": { "enum": ["document", "url", "repository", "reference"] },
          "url": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,95}$" },
    "role": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key", "type", "title", "outcome", "deliverable", "status", "priority",
        "ownerRole", "definitionOfReady", "definitionOfDone", "resourceKeys", "blockedByKeys"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "linearId": { "type": "string", "minLength": 1 },
        "type": { "enum": ["initiative", "task", "decision"] },
        "parentKey": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "context": { "type": "string" },
        "deliverable": { "type": "string", "minLength": 1 },
        "status": { "enum": ["Refinement", "Ready", "Blocked"] },
        "priority": { "enum": ["urgent", "high", "normal", "low", "none"] },
        "ownerRole": { "$ref": "#/$defs/role" },
        "reviewerRole": { "$ref": "#/$defs/role" },
        "definitionOfReady": {
          "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
        },
        "definitionOfDone": {
          "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
        },
        "resourceKeys": {
          "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/key" }
        },
        "blockedByKeys": {
          "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/key" }
        }
      }
    }
  }
}
