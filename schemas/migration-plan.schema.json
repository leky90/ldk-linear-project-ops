{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldktech.dev/schemas/roleflow-contract-migration-plan-v1.schema.json",
  "title": "RoleFlow Contract Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "mode",
    "planId",
    "artifactKind",
    "sourcePath",
    "outputPath",
    "sourceHash",
    "beforeHash",
    "afterHash",
    "beforeArtifact",
    "afterArtifact",
    "diagnostics",
    "eligibleForApply"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "roleflow-contract-migration-plan" },
    "mode": { "enum": ["preview", "apply"] },
    "planId": { "type": "string", "pattern": "^migration-[0-9a-f]{16}$" },
    "artifactKind": { "enum": ["linear-role-work-plan", "linear-role-handoff"] },
    "sourcePath": { "type": "string", "minLength": 1 },
    "outputPath": { "type": "string", "minLength": 1 },
    "sourceHash": { "$ref": "#/$defs/hash" },
    "beforeHash": { "$ref": "#/$defs/hash" },
    "afterHash": { "$ref": "#/$defs/hash" },
    "beforeArtifact": { "type": "object" },
    "beforeBytesBase64": { "type": "string", "minLength": 1, "contentEncoding": "base64" },
    "afterArtifact": { "type": "object" },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warnings", "decisions"],
      "properties": {
        "warnings": { "type": "array", "items": { "type": "string" } },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "path", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "eligibleForApply": { "type": "boolean" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
