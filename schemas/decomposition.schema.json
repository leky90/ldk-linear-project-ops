{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldktech.dev/schemas/linear-decomposition.schema.json",
  "title": "LDK Linear Parent Decomposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "projectId", "parent", "approved", "children"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "linear-parent-decomposition" },
    "projectId": { "type": "string", "minLength": 1 },
    "approved": { "type": "boolean" },
    "parent": {
      "type": "object",
      "required": ["key", "issueId"],
      "properties": {
        "key": { "type": "string" },
        "issueId": { "type": "string" }
      }
    },
    "complexitySignals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "children": {
      "type": "array",
      "minItems": 2,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["key", "title", "description", "status", "acceptanceCriteria", "capabilities", "resources", "blockedByKeys"],
        "properties": {
          "key": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": { "enum": ["Refinement", "Ready", "Blocked"] },
          "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "resources": { "type": "array", "items": { "type": "string" } },
          "blockedByKeys": { "type": "array", "items": { "type": "string" } },
          "claimable": { "type": "boolean" }
        }
      }
    }
  }
}
