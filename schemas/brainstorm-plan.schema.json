{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldktech.dev/schemas/linear-brainstorm-plan.schema.json",
  "title": "LDK Linear Brainstorm Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "projectId", "teamId", "approved", "summary", "milestones", "resources", "issues"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "linear-project-plan" },
    "projectId": { "type": "string", "minLength": 1 },
    "teamId": { "type": "string", "minLength": 1 },
    "approved": { "type": "boolean" },
    "summary": { "type": "string", "minLength": 1 },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "questions": { "type": "array", "items": { "type": "string" } },
    "milestones": {
      "type": "array",
      "items": { "$ref": "#/$defs/milestone" }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,95}$"
    },
    "milestone": {
      "type": "object",
      "required": ["key", "name", "description"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "targetDate": { "type": "string", "format": "date" }
      }
    },
    "resource": {
      "type": "object",
      "required": ["key", "title", "type"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["document", "url", "repository", "reference"] },
        "url": { "type": "string" }
      }
    },
    "issue": {
      "type": "object",
      "required": ["key", "kind", "title", "description", "status", "priority", "labels", "acceptanceCriteria", "capabilities", "resources", "blockedByKeys"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "linearId": { "type": "string" },
        "kind": { "enum": ["parent", "sub-issue", "decision"] },
        "parentKey": { "$ref": "#/$defs/key" },
        "milestoneKey": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "status": { "enum": ["Refinement", "Ready", "Blocked"] },
        "priority": { "enum": ["urgent", "high", "normal", "low", "none"] },
        "priorityRationale": { "type": "string" },
        "labels": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "array", "items": { "type": "string" } },
        "blockedByKeys": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/key" } },
        "claimable": { "type": "boolean" }
      }
    }
  }
}
