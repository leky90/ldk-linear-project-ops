{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldktech.dev/schemas/linear-software-delivery-evidence.schema.json",
  "title": "Linear Software Delivery Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "issueId",
    "capabilities",
    "acceptanceCriteriaVerified",
    "scopedChangesAccounted",
    "git"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "linear-software-delivery-evidence" },
    "issueId": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "contains": { "const": "software.change" },
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptanceCriteriaVerified": { "type": "boolean" },
    "scopedChangesAccounted": { "type": "boolean" },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineId", "changeBaseSha", "scopePaths"],
      "properties": {
        "baselineId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "changeBaseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "scopePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
    "branchName": { "type": "string", "minLength": 1 },
    "branchPushed": { "type": "boolean" },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "draft", "ciStatus", "merged"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "draft": { "type": "boolean" },
        "ciStatus": { "enum": ["passed", "failed", "pending", "not-configured"] },
        "merged": { "type": "boolean" }
      }
    },
    "lastDeliveryChangeAt": { "type": "string", "format": "date-time" },
    "managerAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "acceptedAt"],
      "properties": {
        "accepted": { "type": "boolean" },
        "acceptedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "verified"],
      "properties": {
        "required": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "evidenceUri": { "type": "string", "minLength": 1 }
      }
    }
  }
}
