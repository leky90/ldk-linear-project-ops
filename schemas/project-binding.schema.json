{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldktech.dev/schemas/linear-project-binding.schema.json",
  "title": "Linear Project Ops Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "workflow"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "linearProjectId", "linearTeamId"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "name": { "type": "string", "minLength": 1 },
        "linearProjectId": { "type": "string", "minLength": 1 },
        "linearTeamId": { "type": "string", "minLength": 1 },
        "historicalProjectIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "roles"],
      "properties": {
        "states": {
          "type": "object",
          "additionalProperties": false,
          "required": ["refinement", "ready", "inProgress", "inReview", "blocked", "done"],
          "properties": {
            "refinement": { "type": "string", "minLength": 1 },
            "ready": { "type": "string", "minLength": 1 },
            "inProgress": { "type": "string", "minLength": 1 },
            "inReview": { "type": "string", "minLength": 1 },
            "blocked": { "type": "string", "minLength": 1 },
            "done": { "type": "string", "minLength": 1 }
          }
        },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "label": { "type": "string", "pattern": "^role:[a-z0-9][a-z0-9-]*$" },
              "defaultReviewer": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
            }
          }
        }
      }
    }
  }
}
