{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldktech.dev/schemas/linear-project-binding.schema.json",
  "title": "Linear Project Ops Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "workflow", "coordination"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "linearProjectId", "linearTeamId"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "name": { "type": "string", "minLength": 1 },
        "linearProjectId": { "type": "string", "minLength": 1 },
        "linearTeamId": { "type": "string", "minLength": 1 },
        "historicalProjectIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "labels"],
      "properties": {
        "states": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ready", "inProgress", "inReview", "blocked", "done"],
          "properties": {
            "ready": { "type": "string", "minLength": 1 },
            "inProgress": { "type": "string", "minLength": 1 },
            "inReview": { "type": "string", "minLength": 1 },
            "blocked": { "type": "string", "minLength": 1 },
            "done": { "type": "string", "minLength": 1 }
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parent", "subIssue", "decision"],
          "properties": {
            "parent": { "type": "string" },
            "subIssue": { "type": "string" },
            "decision": { "type": "string" }
          }
        },
        "softwareDelivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentActions", "childDoneRequires", "reviewRequires", "doneRequires", "deployment"],
          "properties": {
            "agentActions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["commit", "push", "open-pull-request", "mark-pull-request-ready", "merge", "deploy"]
              }
            },
            "childDoneRequires": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "allOf": [
                { "contains": { "const": "acceptance-criteria" } },
                { "contains": { "const": "scoped-changes-accounted" } }
              ],
              "items": {
                "enum": ["acceptance-criteria", "scoped-changes-accounted", "commit"]
              }
            },
            "reviewRequires": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "allOf": [
                { "contains": { "const": "acceptance-criteria" } },
                { "contains": { "const": "scoped-changes-accounted" } }
              ],
              "items": {
                "enum": ["acceptance-criteria", "scoped-changes-accounted", "commit", "push", "pull-request", "non-draft-pull-request", "ci"]
              }
            },
            "doneRequires": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "allOf": [
                { "contains": { "const": "manager-acceptance" } },
                { "contains": { "const": "acceptance-after-last-delivery" } }
              ],
              "items": {
                "enum": ["manager-acceptance", "acceptance-after-last-delivery", "merge"]
              }
            },
            "deployment": { "enum": ["never", "when-required", "always"] }
          }
        }
      }
    },
    "coordination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "leaseMinutes", "heartbeatMinutes", "runBudgetMinutes"],
      "properties": {
        "mode": {
          "enum": ["atomic-local-lease", "shared-lease-service", "linear-optimistic"]
        },
        "databasePath": { "type": "string", "minLength": 1 },
        "leaseMinutes": { "type": "integer", "minimum": 5, "maximum": 240 },
        "heartbeatMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "runBudgetMinutes": { "type": "integer", "minimum": 5, "maximum": 240 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "atomic-local-lease" } } },
          "then": { "required": ["databasePath"] }
        }
      ]
    }
  }
}
