{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldktech.dev/schemas/linear-legacy-cleanup-plan.schema.json",
  "title": "Linear Legacy Cleanup Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "mode", "projectId", "planId", "snapshotAt", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "linear-legacy-cleanup-plan" },
    "mode": { "enum": ["preview", "apply"] },
    "projectId": { "type": "string", "minLength": 1 },
    "planId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,95}$" },
    "snapshotAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityType", "id", "action", "reason", "preserve", "approved"],
        "properties": {
          "entityType": { "enum": ["issue", "comment", "resource"] },
          "id": { "type": "string", "minLength": 1 },
          "action": { "enum": ["KEEP", "NORMALIZE", "MERGE_THEN_DELETE", "CONVERT_TO_RESOURCE_THEN_DELETE", "DELETE_ISSUE", "DELETE_COMMENT", "NEEDS_DECISION"] },
          "canonicalIssueId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "preserve": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "approved": { "type": "boolean" }
        }
      }
    }
  }
}
