{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-entry.mjs\" SessionStart",
            "statusMessage": "linear project ops: loading project boundary"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-entry.mjs\" UserPromptSubmit",
            "statusMessage": "linear project ops: routing project work"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__linear__.*|linear.*|create_issue|update_issue|create_project|update_project|create_comment|create_issue_label",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-entry.mjs\" PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__linear__.*|linear.*|create_issue|update_issue|create_project|update_project|create_comment|create_issue_label",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-entry.mjs\" PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-entry.mjs\" Stop"
          }
        ]
      }
    ]
  }
}
